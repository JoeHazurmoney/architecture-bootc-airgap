# Managed by Ansible (role bootc_pxe). Do not edit on the server.
# Entry point loaded by grubx64.efi. A known MAC loads its host file
# (zero-touch). Anything else gets the full menu, which defaults to the local disk.
set timeout={{ bootc_pxe_menu_timeout }}
if [ -n "${net_default_mac}" -a -f "${prefix}/hosts/${net_default_mac}.cfg" ]; then
  configfile "${prefix}/hosts/${net_default_mac}.cfg"
fi
configfile "${prefix}/menu.cfg"

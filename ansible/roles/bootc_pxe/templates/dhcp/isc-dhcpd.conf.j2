# Generated by Ansible (role bootc_pxe). Include in dhcpd.conf.
option arch code 93 = unsigned integer 16;

class "bootc-uefi-pxe" {
  match if option arch = 00:07 or option arch = 00:09;
  next-server {{ bootc_pxe_server_ip }};
  filename "{{ bootc_pxe_tftp_subdir }}/EFI/BOOT/{{ __bootc_pxe_efi_loader }}";
}

class "bootc-uefi-http" {
  match if substring (option vendor-class-identifier, 0, 10) = "HTTPClient";
  option vendor-class-identifier "HTTPClient";
  filename "{{ bootc_pxe_http_url }}/EFI/BOOT/{{ __bootc_pxe_efi_loader }}";
}
{% if bootc_pxe_bios_support %}

class "bootc-bios-pxe" {
  match if option arch = 00:00;
  next-server {{ bootc_pxe_server_ip }};
  filename "{{ bootc_pxe_tftp_subdir }}/bios/i386-pc/core.0";
}
{% endif %}

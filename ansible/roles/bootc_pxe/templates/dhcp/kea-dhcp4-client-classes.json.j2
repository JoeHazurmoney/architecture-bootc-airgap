{
  "_comment": "Generated by Ansible (role bootc_pxe). Merge into Dhcp4.client-classes.",
  "client-classes": [
    {
      "name": "bootc-uefi-pxe",
      "test": "option[93].hex == 0x0007 or option[93].hex == 0x0009",
      "next-server": "{{ bootc_pxe_server_ip }}",
      "boot-file-name": "{{ bootc_pxe_tftp_subdir }}/EFI/BOOT/{{ __bootc_pxe_efi_loader }}"
    },
    {
      "name": "bootc-uefi-http",
      "test": "option[93].hex == 0x0010",
      "boot-file-name": "{{ bootc_pxe_http_url }}/EFI/BOOT/{{ __bootc_pxe_efi_loader }}",
      "option-data": [
        { "name": "vendor-class-identifier", "data": "HTTPClient" }
      ]
    }{% if bootc_pxe_bios_support %},
    {
      "name": "bootc-bios-pxe",
      "test": "option[93].hex == 0x0000",
      "next-server": "{{ bootc_pxe_server_ip }}",
      "boot-file-name": "{{ bootc_pxe_tftp_subdir }}/bios/i386-pc/core.0"
    }{% endif %}

  ]
}

# Generated by Ansible (role bootc_pxe).
# Proxy-DHCP: use when you can't change the authoritative DHCP server.
# The real server keeps handing out leases; dnsmasq adds the PXE boot answer.
# Set bootc_pxe_dhcp_mode: proxy to have the role run this for you.
port=0
dhcp-range={{ bootc_pxe_proxy_dhcp_network | default('<provisioning-network>', true) }},proxy
dhcp-match=set:efi-x64,option:client-arch,7
dhcp-match=set:efi-x64,option:client-arch,9
pxe-prompt="bootc network install",3
pxe-service=tag:efi-x64,x86-64_EFI,"bootc network install",{{ bootc_pxe_tftp_subdir }}/EFI/BOOT/{{ __bootc_pxe_efi_loader }},{{ bootc_pxe_server_ip }}

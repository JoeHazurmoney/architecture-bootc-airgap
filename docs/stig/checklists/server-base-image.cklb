 "stigs": [
  {
   "stig_name": "Red Hat Enterprise Linux 10 Security Technical Implementation Guide",
   "display_name": "Red Hat Enterprise Linux 10 STIG",
   "stig_id": "RHEL_10_STIG",
   "release_info": "Release: 2 Benchmark Date: 01 Jul 2026",
